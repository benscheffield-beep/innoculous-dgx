+    expect(r.verdict).not.toBe("fail");
+  });
+
+  it("CHK08 passes when closed-form residual is within tol", async () => {
+    const p = basePayload({ closed_form_residual: 1e-6 });
+    const r = await runVerifier(p, computeArtifactHash(p));
+    expect(r.issues.some(i => i.check_id === "CHK08")).toBe(false);
+    expect(r.verdict).toBe("pass");
+  });
